# Template environment backend — copy ke `.env` lalu isi nilainya.

# --- LLM: DeepSeek V4.1 Flash ---
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# Batas token output Feasibility Check (F-02). Topik kompleks (mis. Mandarin)
# butuh token lebih banyak untuk thinking + benchmark.
FEASIBILITY_MAX_TOKENS=16384

# --- Performance tuning: plan generation (F-03) / reschedule apply (F-05) ---
# Detail mingguan yang digenerate penuh (minggu lain mengikuti tema milestone).
PLAN_DETAILED_WEEKS=2
PLAN_MAX_TOKENS=16384
# "low" | "medium" | "high" — medium cukup untuk output berbasis pola.
PLAN_REASONING_EFFORT=medium
RESCHEDULE_APPLY_REASONING_EFFORT=medium

# --- Database: PostgreSQL 16 + pgvector ---
# Format: postgresql+psycopg2://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/study_agent

# --- App ---
APP_ENV=development
CORS_ORIGINS=http://localhost:3000

# --- Auth / JWT (F-09) ---
# WAJIB pakai secret random minimal 32 karakter di production!
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
